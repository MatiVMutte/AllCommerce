SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Opcional: URL pública de la web (vacío = no se incluye link en el mensaje de WhatsApp)
PUBLIC_BASE_URL=
# Opcional: WhatsApp de soporte en E.164 sin '+' (vacío = botón deshabilitado)
SUPPORT_WHATSAPP=

# Opcional: Firebase para push notifications. Si falta alguno, se desactivan.
FIREBASE_API_KEY=client.api_key.current_key
FIREBASE_APP_ID=client.client_info.mobilesdk_app_id
FIREBASE_MESSAGING_SENDER_ID=project_info.project_number
FIREBASE_PROJECT_ID=project_info.project_id
FIREBASE_AUTH_DOMAIN=project_info.firebase_url
FIREBASE_STORAGE_BUCKET=project_info.storage_bucket
FIREBASE_MEASUREMENT_ID=
# Solo Web: "Web Push certificate" (VAPID) de Firebase Console →
# Cloud Messaging → Web configuration. Sin esto no hay push nativo en web
# (la alerta dentro de la app sigue funcionando).
FIREBASE_VAPID_KEY=
